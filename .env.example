# Luxytrades Admin API — environment
# Copy to .env and fill in real values. .env is gitignored.

# ---- Neon Postgres (pooled + direct) ----
# Pooled connection (use this for DATABASE_URL, includes ?sslmode=require&pgbouncer=true for Neon pools)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX-pooler.region.aws.neon.tech/luxytrades?sslmode=require"
# Direct (non-pooled) connection — used by `prisma migrate` / `prisma db push`
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXX.region.aws.neon.tech/luxytrades?sslmode=require"

# ---- Auth ----
JWT_SECRET="change-me-32+random-bytes"
# base64-encoded 32-byte key for AES-256-GCM gateway-secret encryption
GATEWAY_SECRET=""

# ---- Webhook signing secrets (HMAC-SHA256 over the raw body) ----
MPESA_WEBHOOK_SECRET=""
CRYPTO_WEBHOOK_SECRET=""
WEBHOOK_DEFAULT_SECRET=""

# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS (the Vite dev server / prod admin host)
CORS_ORIGIN="http://localhost:3001,http://localhost:5173"

# ---- Frontend feature flag (put the same in a root .env for Vite) ----
# Set to 1 to make the console talk to this API instead of the in-memory mock.
VITE_ADMIN_LIVE=1

# ---- M-Pesa Daraja STK push (real Safaricom mobile-money deposits) ----
# Environment selector: "production" hits api.safaricom.co.ke, "sandbox" hits sandbox.safaricom.co.ke
MPESA_ENV=sandbox
# From your Daraja app (Lipa na M-Pesa > Online). Valid keys are 64 chars.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
# Passkey (SafeLogin password / API passkey) used to build the STK Password.
MPESA_PASSKEY=""
# Head-office PAYBILL shortcode — REQUIRED. Used as BusinessShortCode and to sign the
# STK Password. Without it the gateway is treated as unconfigured.
MPESA_SHORTCODE=""
# Till number — carried as the AccountReference ("Party B") under the head office.
MPESA_TILL_NUMBER=""
# Advisory flow hint. The server derives the real TransactionType: CustomerPayBillOnline
# whenever MPESA_SHORTCODE is set (head office), otherwise CustomerBuyGoodsOnline (till).
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS URL where Safaricom posts the STK callback (must be reachable from the internet).
MPESA_CALLBACK_URL="https://yourdomain.com/api/payments/mpesa/callback"
# Account reference shown on the customer's message (defaults to the trader id / checkout id).
MPESA_ACCOUNT_REF="LUXYTRADES"
# Short description text in the STK prompt.
MPESA_TRANSACTION_DESC="Luxytrades deposit"
# USD -> KES conversion used when the trader funds in USD but pays in KES.
MPESA_KES_RATE=129.4
